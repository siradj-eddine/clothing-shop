apiVersion: v1
kind: Secret
metadata:
  name: clothing-shop-secrets
  namespace: clothing-shop
type: Opaque
stringData:
  SECRET_KEY: "REPLACE_WITH_NEW_DJANGO_SECRET_KEY"
  DB_PASSWORD: "REPLACE_WITH_NEW_NEON_DB_PASSWORD"
  AWS_ACCESS_KEY_ID: "REPLACE_WITH_NEW_R2_ACCESS_KEY"
  AWS_SECRET_ACCESS_KEY: "REPLACE_WITH_NEW_R2_SECRET_KEY"
  RESEND_API_KEY: "REPLACE_WITH_NEW_RESEND_KEY"
  BREVO_API_KEY: "REPLACE_WITH_NEW_BREVO_KEY"
  EMAIL_HOST_PASSWORD: "REPLACE_WITH_NEW_EMAIL_PASSWORD"