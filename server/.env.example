# Database Configuration (Neon Cloud)
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=your_database_host
DB_PORT=5432

# Django Settings
DEBUG=False
SECRET_KEY=your-secret-key-here

# Frontend URL (Vercel)
FRONTEND_URL=https://your-store.vercel.app

# Backend URL (Render)
ALLOWED_HOSTS=your-backend.onrender.com

# Cloudflare R2 Settings
AWS_ACCESS_KEY_ID=your_r2_key
AWS_SECRET_ACCESS_KEY=your_r2_secret
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_ENDPOINT_URL=your_r2_endpoint
AWS_S3_REGION_NAME=auto
AWS_S3_CUSTOM_DOMAIN=your_r2_domain

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Email Settings
RESEND_API_KEY=your_resend_key
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_password
DEFAULT_FROM_EMAIL=your@email.com
BREVO_API_KEY=your_brevo_key